    "@supabase/supabase-js": "^2.47.0",
    "chromadb": "^1.9.0",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "inquirer": "^12.0.0",
    "ora": "^8.1.0",
    "uuid": "^10.0.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
