# Workflow Architect - Environment Schema (VarLock compatible)
# See: https://varlock.dev/guides/schema/

# =============================================================================
# n8n Configuration
# =============================================================================

# @description=n8n instance base URL
# @type=url
# @required
N8N_BASE_URL=http://localhost:5678

# @description=n8n API key for workflow management
# @type=string(minLength=32)
# @required @sensitive
N8N_API_KEY=

# =============================================================================
# AI Model Configuration
# =============================================================================

# @description=Primary model to use (claude-opus-4-5, gemini-3-pro, gpt-5.2-codex)
# @type=enum(claude-opus-4-5, gemini-3-pro, gpt-5.2-codex)
# @default=claude-opus-4-5
PRIMARY_MODEL=claude-opus-4-5

# @description=Anthropic API key for Claude models
# @type=string(startsWith=sk-ant-)
# @sensitive
ANTHROPIC_API_KEY=

# @description=Google AI API key for Gemini models
# @type=string
# @sensitive
GOOGLE_AI_API_KEY=

# @description=OpenAI API key for GPT models
# @type=string(startsWith=sk-)
# @sensitive
OPENAI_API_KEY=

# @description=Token threshold for switching to large-context model
# @type=number(min=10000, max=500000)
# @default=100000
LARGE_CONTEXT_THRESHOLD=100000

# =============================================================================
# RAG Configuration
# =============================================================================

# @description=Vector store type (chroma, pinecone, local)
# @type=enum(chroma, pinecone, local)
# @default=local
VECTOR_STORE_TYPE=local

# @description=Chroma DB URL (if using chroma)
# @type=url
CHROMA_URL=http://localhost:8000

# @description=Pinecone API key (if using pinecone)
# @type=string
# @sensitive
PINECONE_API_KEY=

# @description=Pinecone index name
# @type=string
PINECONE_INDEX=

# =============================================================================
# Server Configuration
# =============================================================================

# @description=Workflow Architect server port
# @type=port
# @default=3080
PORT=3080

# @description=Enable debug logging
# @type=boolean
# @default=false
DEBUG=false

# @description=Session timeout in minutes
# @type=number(min=5, max=1440)
# @default=60
SESSION_TIMEOUT=60
